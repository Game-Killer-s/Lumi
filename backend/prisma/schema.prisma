// Prisma schema for Lumi music streaming platform
// This file describes the database structure (tables and relations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Користувач (Слухач або Адмін)
// ============================================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nickname     String
  role         Role     @default(LISTENER)
  avatarUrl    String?
  isPublic     Boolean  @default(true)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  playlists      Playlist[]
  likes          Like[]
  history        History[]
  subscriptions  Subscription[]
  comments       Comment[]
  reports        Report[]
  authSessions   AuthSession[]
  trackAuditLogs TrackAuditLog[]

  passwordResetTokens  PasswordResetToken[]
  notificationSettings NotificationSettings?
  notifications        UserNotification[]
  userSubscriptions    UserSubscription[]
  paymentMethods       PaymentMethod[]
  payments             Payment[]
}

model AuthSession {
  id               String @id
  userId           String
  familyId         String
  currentJti       String @unique
  refreshTokenHash String

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ============================================================
// Токен скидання пароля (відновлення доступу)
// ============================================================
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Ролі користувачів
enum Role {
  LISTENER
  ARTIST
  CONTENT_MANAGER
  ADMIN
}

// ============================================================
// Виконавець
// ============================================================
model Artist {
  id          String   @id @default(uuid())
  name        String
  photoUrl    String?
  description String?
  createdAt   DateTime @default(now())

  tracks    Track[]
  albums    Album[]
  followers Subscription[]
}

// ============================================================
// Жанр музики
// ============================================================
model Genre {
  id    String  @id @default(uuid())
  name  String  @unique
  color String?

  tracks Track[]
}

// ============================================================
// Альбом
// ============================================================
model Album {
  id          String   @id @default(uuid())
  title       String
  coverUrl    String?
  releaseYear Int?
  artistId    String
  createdAt   DateTime @default(now())

  artist Artist  @relation(fields: [artistId], references: [id])
  tracks Track[]
}

// ============================================================
// Трек
// ============================================================
model Track {
  id          String      @id @default(uuid())
  title       String
  duration    Int
  coverUrl    String?
  audioUrl    String?
  lyrics      String?
  playCount   Int         @default(0)
  likeCount   Int         @default(0)
  status      TrackStatus @default(PUBLISHED)
  blockReason String?
  artistId    String
  genreId     String?
  albumId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  artist Artist @relation(fields: [artistId], references: [id])
  genre  Genre? @relation(fields: [genreId], references: [id])
  album  Album? @relation(fields: [albumId], references: [id])

  playlistTracks PlaylistTrack[]
  likes          Like[]
  history        History[]
  comments       Comment[]
  reports        Report[]
  auditLogs      TrackAuditLog[]
}

// Журнал дій над треком (хто, коли, що і чому змінив)
model TrackAuditLog {
  id        String   @id @default(uuid())
  trackId   String
  actorId   String
  action    String
  reason    String?
  details   String?
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([trackId])
}

// Статус треку (життєвий цикл контенту)
enum TrackStatus {
  DRAFT
  UPLOADED
  PROCESSING
  ON_MODERATION
  PUBLISHED
  BLOCKED
}

// ============================================================
// Плейлист
// ============================================================
model Playlist {
  id          String   @id @default(uuid())
  title       String
  description String?
  coverUrl    String?
  isOfficial  Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?           @relation(fields: [userId], references: [id])
  tracks PlaylistTrack[]
}

// Зв'язок плейлист <-> трек (багато-до-багатьох)
model PlaylistTrack {
  id         String @id @default(uuid())
  playlistId String
  trackId    String
  position   Int    @default(0)

  playlist Playlist @relation(fields: [playlistId], references: [id])
  track    Track    @relation(fields: [trackId], references: [id])

  @@unique([playlistId, trackId])
}

// ============================================================
// Вподобайки (Улюблене)
// ============================================================
model Like {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  track Track @relation(fields: [trackId], references: [id])

  @@unique([userId, trackId])
}

// ============================================================
// Історія прослуховувань
// ============================================================
model History {
  id       String   @id @default(uuid())
  userId   String
  trackId  String
  playedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  track Track @relation(fields: [trackId], references: [id])
}

// ============================================================
// Підписка на виконавця
// ============================================================
model Subscription {
  id        String   @id @default(uuid())
  userId    String
  artistId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([userId, artistId])
}

// ============================================================
// Коментар до треку
// ============================================================
model Comment {
  id        String   @id @default(uuid())
  text      String
  userId    String
  trackId   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  track Track @relation(fields: [trackId], references: [id])
}

// ============================================================
// Скарга на трек
// ============================================================
model Report {
  id        String       @id @default(uuid())
  reason    String
  userId    String
  trackId   String
  status    ReportStatus @default(NEW)
  createdAt DateTime     @default(now())

  user  User  @relation(fields: [userId], references: [id])
  track Track @relation(fields: [trackId], references: [id])
}

enum ReportStatus {
  NEW
  REVIEWED
  RESOLVED
}

// ============================================================
// Тарифний план (Free / Premium / Family)
// ============================================================
model SubscriptionPlan {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  priceCents  Int
  currency    String   @default("UAH")
  periodDays  Int      @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions UserSubscription[]
}

// Стан підписки користувача
enum SubscriptionStatus {
  PENDING
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

// Спосіб оплати
enum PaymentProvider {
  CARD
  GOOGLE_PAY
  STRIPE
  LIQPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ============================================================
// Підписка користувача на тариф
// ============================================================
model UserSubscription {
  id               String             @id @default(uuid())
  userId           String
  planId           String
  status           SubscriptionStatus @default(PENDING)
  provider         PaymentProvider    @default(CARD)
  currentPeriodEnd DateTime?
  gracePeriodEndsAt    DateTime?
  lastPaymentFailedAt  DateTime?
  cancelAtPeriodEnd    Boolean        @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
}

// ============================================================
// Збережена картка (номер не зберігаємо — лише маску)
// ============================================================
model PaymentMethod {
  id         String   @id @default(uuid())
  userId     String
  brand      String
  last4      String
  expMonth   Int
  expYear    Int
  holderName String?
  isDefault  Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// Платіж (історія транзакцій платіжного шлюзу)
// ============================================================
model Payment {
  id             String          @id @default(uuid())
  userId         String
  subscriptionId String?
  amountCents    Int
  currency       String          @default("UAH")
  status         PaymentStatus   @default(PENDING)
  provider       PaymentProvider @default(CARD)
  externalId     String          @unique
  failureReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
}

// ============================================================
// Налаштування сповіщень користувача
// ============================================================
model NotificationSettings {
  id              String   @id @default(uuid())
  userId          String   @unique
  newReleases     Boolean  @default(true)
  artistUpdates   Boolean  @default(true)
  platformUpdates Boolean  @default(true)
  systemNotifications Boolean @default(true)
  pushEnabled     Boolean  @default(true)
  emailEnabled    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// Сповіщення у шторці застосунку
// ============================================================
model UserNotification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  // payload — метадані події (артист, альбом, реліз).
  payload   Json?
  // releaseId — щоб одному користувачу прийшло одне сповіщення на реліз.
  releaseId String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}
