# Example environment variables
PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

JWT_ISSUER=lumi-api
JWT_AUDIENCE=lumi-android

# Google Sign-In (optional, fill in for Google login)
GOOGLE_CLIENT_ID=

# Email sending (optional; without SMTP the mail is printed to the server console)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Lumi <no-reply@lumi.app>

# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumi?schema=public"

# Cache stale window in milliseconds
CACHE_STALE_WINDOW_MS=60000

# Performance metrics thresholds in milliseconds
SLOW_REQUEST_THRESHOLD_MS=500
SLOW_QUERY_THRESHOLD_MS=100

# Payments (card = вбудована заглушка шлюзу, stripe/liqpay — коли будуть ключі)
PAYMENT_PROVIDER=card
PAYMENT_WEBHOOK_SECRET=lumi-webhook-secret
