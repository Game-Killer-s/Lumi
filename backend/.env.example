# Example environment variables
PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

JWT_ISSUER=lumi-api
JWT_AUDIENCE=lumi-android
# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumi?schema=public"


TWO_FACTOR_ENCRYPTION_KEY=
SECURITY_HMAC_KEY=

TWO_FACTOR_ISSUER=Lumi

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/oauth/google/callback

OAUTH_ALLOWED_RETURN_URLS=lumi://oauth/callback